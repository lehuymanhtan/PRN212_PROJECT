<UserControl x:Class="AIStudyHub.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIStudyHub.Converters"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <conv:TypeToVietnameseConverter x:Key="TypeToVietnamese"/>
        <conv:NullableDateToStringConverter x:Key="NullableDateToString"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
        <StackPanel>

            <!-- Page Title -->
            <Grid Margin="0,0,0,20">
                <TextBlock Text="📊 Tổng quan Học tập (Dashboard Overview)" Style="{StaticResource H1Style}"/>
                <Button HorizontalAlignment="Right" Content="↺ Cập nhật" Command="{Binding RefreshDataCommand}" Style="{StaticResource NavButtonStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
            </Grid>

            <!-- STATS CARDS -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="📚 Môn học" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalSubjects}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="📝 Tổng Task/Exam" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalTasks}" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="⏳ Cần hoàn thành" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PendingTasks}" FontSize="28" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚠ Quá hạn" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding OverdueTasks}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- MY SUBJECTS SECTION -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Danh sách Môn học (Subjects)" Style="{StaticResource H2Style}"/>
            </Grid>
            
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,24">
                <DataGrid ItemsSource="{Binding Subjects}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" MinHeight="120" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Môn" Binding="{Binding CourseCode}" Width="120"/>
                        <DataGridTextColumn Header="Tên Môn Học" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Mã Màu" Binding="{Binding ColorHex}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- DEADLINES & EXAMS SECTION -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Quản lý Lịch thi &amp; Deadline (Tasks)" Style="{StaticResource H2Style}"/>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="10">
                <DataGrid ItemsSource="{Binding RecentTasks}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" MinHeight="220" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Công Việc / Kỳ Thi" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Môn Học" Binding="{Binding Subject.Name}" Width="200"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding Type, Converter={StaticResource TypeToVietnamese}}" Width="120"/>
                        <DataGridTextColumn Header="Hạn Chót (Deadline)" Binding="{Binding DueDate, Converter={StaticResource NullableDateToString}}" Width="180"/>
                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="120"/>

                        <DataGridTemplateColumn Header="Thao tác" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✓ Xong" Command="{Binding DataContext.MarkTaskDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="8,4" FontSize="11" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
