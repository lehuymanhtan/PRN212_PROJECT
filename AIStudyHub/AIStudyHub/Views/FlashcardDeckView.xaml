<UserControl x:Class="AIStudyHub.Views.FlashcardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIStudyHub.Views"
             xmlns:viewmodels="clr-namespace:AIStudyHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header & Tabs -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Flashcards &amp; Notes" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            
            <!-- Tab Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Flashcards" Command="{Binding SwitchToFlashcardsCommand}" Cursor="Hand" Padding="15,8" Margin="0,0,10,0" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlashcardsTabActive}" Value="True">
                                    <Setter Property="Background" Value="Indigo"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="15,8"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button Content="Notes" Command="{Binding SwitchToNotesCommand}" Cursor="Hand" Padding="15,8" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="15,8"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- FLASHCARDS TAB -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlashcardsTabActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Decks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="15" Margin="10" Width="200" Height="150">
                                <Border.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.3" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Button Grid.Row="1" Content="Review" Command="{Binding DataContext.ReviewDeckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Height="30" Background="Indigo" Foreground="White" Cursor="Hand" Margin="0,10,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                    Width="60" Height="60" Command="{Binding OpenCreateDeckModalCommand}" Background="Indigo" Foreground="White" BorderThickness="0"
                    ToolTip="Create new flashcard deck" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="30">
                            <TextBlock Text="+" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        
        <!-- NOTES TAB -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotesTabActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="15" Margin="10" Width="280" Height="200">
                                <Border.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.3" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding UpdatedAt, StringFormat='{}Last updated: {0:MMM dd, yyyy}'}" FontSize="12" Foreground="Gray" Margin="0,5,0,10"/>
                                    
                                    <TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="14" Foreground="#444" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Edit" Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="MediumSeaGreen" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,5,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <TextBlock Text="{TemplateBinding Content}" Padding="10,5"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#FF5252" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <TextBlock Text="{TemplateBinding Content}" Padding="10,5"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                    Width="60" Height="60" Command="{Binding OpenCreateNoteModalCommand}" Background="MediumSeaGreen" Foreground="White" BorderThickness="0"
                    ToolTip="Create new note" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="30">
                            <TextBlock Text="+" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        
        <!-- MODALS -->
        
        <!-- Create Deck Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsCreateDeckModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Create New Deck" FontWeight="Bold" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding CloseCreateDeckModalCommand}" Background="Transparent" Foreground="Gray" BorderThickness="0" HorizontalAlignment="Right" FontSize="16" Width="30" Height="30" Cursor="Hand"/>
                    </Grid>
                    
                    <TextBlock Text="Deck Title:" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewDeckTitle, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Subject:" FontSize="14" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name" Height="30" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseCreateDeckModalCommand}" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Create" Command="{Binding CreateDeckCommand}" Width="100" Height="35" Background="Indigo" Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit/Create Note Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsEditNoteModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Height="450">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Edit Note" FontWeight="Bold" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding CloseEditNoteModalCommand}" Background="Transparent" Foreground="Gray" BorderThickness="0" HorizontalAlignment="Right" FontSize="16" Width="30" Height="30" Cursor="Hand"/>
                    </Grid>
                    
                    <TextBox Grid.Row="1" Text="{Binding EditingNoteTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="5" Margin="0,0,0,15"/>
                    
                    <TextBox Grid.Row="2" Text="{Binding EditingNoteContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,15"/>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseEditNoteModalCommand}" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Save Note" Command="{Binding SaveNoteCommand}" Width="120" Height="35" Background="MediumSeaGreen" Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
